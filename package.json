{
  "name": "my-app",
  "private": true,
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch server/index.js",
    "dev:web": "npm --prefix client run dev",
    "build": "npm --prefix client run build",
    "start": "node server/index.js",
    "db:sync": "node server/db/sync.js",
    "db:sync:alter": "node server/db/sync.js --alter",
    "db:sync:force": "node server/db/sync.js --force",
    "setup": "npm i && npm --prefix client i && npm --prefix server i"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
